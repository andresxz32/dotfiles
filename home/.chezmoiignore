# Paths below are matched against the TARGET path (relative to $HOME),
# i.e. after chezmoi strips "dot_" prefixes and ".tmpl" suffixes.

{{- if ne .chezmoi.os "windows" }}
# Windows-only targets: skip everywhere else
AppData/**
Documents/PowerShell/**
{{- end }}

{{- if eq .chezmoi.os "windows" }}
{{- if .useWSL }}
# On Windows+WSL, the *nix shell config lives inside the WSL distro,
# not on the Windows filesystem — so skip it at the Windows layer.
# (starship.toml is intentionally NOT ignored here — both native PowerShell
# and the WSL shell share the exact same prompt config file.)
.zshrc
.config/nvim/**
{{- else }}
# Not using WSL: the Windows Terminal WSL-launch fragment doesn't apply
AppData/Local/Microsoft/Windows Terminal/Fragments/dotfiles/fragment.json
{{- end }}
{{- end }}

# Never manage local machine-specific overrides
.zshrc.local
.gitconfig.local
.ps_profile.local.ps1

# Scripts: only run the ones matching this machine's OS
{{- if eq .chezmoi.os "windows" }}
.chezmoiscripts/unix/**
{{- else }}
.chezmoiscripts/windows/**
{{- end }}

# VS Code settings: one copy per OS, since the path itself differs by platform
{{- if ne .chezmoi.os "linux" }}
.config/Code/User/settings.json
{{- end }}
{{- if ne .chezmoi.os "darwin" }}
Library/Application Support/Code/User/settings.json
{{- end }}
